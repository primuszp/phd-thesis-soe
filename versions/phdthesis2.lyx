\end_inset


\end_layout

\begin_layout Standard
vagy átrendezve 
\begin_inset Formula $K$
\end_inset

-ra
\begin_inset Formula 
\begin{equation}
K\approx0,0131\left[h^{-1,95}\left(\frac{1,9}{c}-1\right)\right]^{1,428}
