\begin_layout Plain Layout
\begin_inset Caption

\begin_layout Plain Layout
A Hook-féle törvény értelmezése húzás esetén 
\begin_inset CommandInset label
LatexCommand label
name "fig:normal-force"

\end_inset


\end_layout

\end_inset


