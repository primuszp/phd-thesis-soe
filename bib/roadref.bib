@ARTICLE{Primusz2010,
  author = {Péter Primusz and Gergely Markó},
  title = {Kétrétegű pályaszerkezetemodellek paramétereinek meghatározása FWD
	mérések alapján},
  journal = {Közlekedésépítési Szemle},
  year = {2010},
  volume = {60},
  pages = {8-13},
  number = {7},
  month = {7},
  abstract = {The paper introduces a new method for calculating the elastic moduli
	of the pavement layers. The method requires only two input parameters:
	the thickness of the upper „bound” layer and the falling weight deflectometer
	(FWD) measurement data. The authors developed a continuously differentiable
	regression function, which can be applied to describe the shape of
	the deflection bowl. Additional parameters of the deflection bowl
	(e.g. radius of curvature, position of the inflexion point) can be
	calculated based on the regression function. FWD measurements were
	simulated running the „Bisar” software on 1728 different pavement
	variations. Outputs of the simulations were further processed with
	own developed software. As a result, a series of diagrams were elaborated,
	by which the elastic moduli of the pavement layers can be determined.},
  huname = {1},
  owner = {_Primusz Péter},
  timestamp = {2010.07.19},
  url = {http://efelt.emk.nyme.hu/primuszp/publications/articles/ketretegu_palyaszerkezetmodellek_parametereinek_meghatarozasa_FWD_meresek_alapjan.pdf}
}

@ARTICLE{Primusz2009,
  author = {Péter Primusz and Csaba Tóth},
  title = {A behajlási teknő geometriája},
  journal = {Közlekedésépítési Szemle},
  year = {2009},
  volume = {59},
  pages = {18--24, 28},
  number = {12},
  month = {12},
  abstract = {The bearing capacity of a pavement can be measured in situ and in
	an indirect way. For this goal often deflection measurements are
	used on public roads: the commonly used Benkelman beam, the Lacroix
	deflectograph and the nowadays developed Falling Weight Deflectometer
	(FWD).The FWDs they are capable measurement of the vertical deflections
	from the load in optional distance. It is possible to fit a function
	onto the discreet deflection measuerement values. The fitted function
	offers a fast definable methods for the radius of curvature calculation.
	Importance of the radius of curveture in the estimitation of the
	bearing capacity of the pavement was early well knowd.The remaining
	lifetime of structure layers is a very important question for the
	civil engineers. In the course of the calculation we found that the
	the critical extension directly based on the radius of curvature.},
