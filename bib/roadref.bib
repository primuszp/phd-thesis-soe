@INPROCEEDINGS{Kosztka2008,
  author = {Miklós Kosztka and Gergely Markó and József Péterfalvi and Péter
	Primusz and Csaba Tóth},
  title = {Erdészeti utak teherbírásának mérése},
  booktitle = {A Magyar Tudományos Akadémia, Agrártudományok Osztálya, Agrárműszaki
	Bizottság, XXXII. Kutatási és Fejlesztési Tanácskozás előadásainak
	és konzultációs témáinak összefoglalói},
  year = {2008},
  editor = {László Tóth and László Magó},
  volume = {3},
  number = {32},
  pages = {75--79},
  organization = {A Magyar Tudományos Akadémia, Agrártudományok Osztálya, Agrárműszaki
	Bizottság},
  publisher = {SZIE, Gödöllő},
  abstract = {Pavement maintenance costs are in close contact with the condition
	of the track pavement and the phase of deterioration progress. The
	bearing capacity of a pavement can be measured in situ and in an
	indirect way. For this goal often deflection measurements are used
	on forest roads: the commonly used Benkelman beam, the Lacroix deflectograph
	and the nowadays developed Falling Weight Deflectometer (FWD). All
	methods simulate the traffic of roads in different ways. The pavement
	behaviour depends on load level and loading speed so deflections
	measured by these methods are different. This paper introduces two
	in-situ measurements. In 2007 we measured deflection on a forest
	road parallel with Benkelman beam and FWD. In 1984 comparative measurements
	were performed on the same road using the Benkelman beam and the
	Lacroix deflectograph. We compared above mentioned methods and found
	satisfactory linear correlation between them. Uniform subsections
	were separated and the definitive bearing capacity of the subsections
	were calculated. For the determination of the required asphalt thickness
	we used the AASH(T)O (American Association Highway (and Transportation)
	Officials) method. In the course of the calculation we found that
	the uniform subsections were defined with
	
	different methods similar to each other and the difference of measuring
	method have not an effect on total asphalt thickness.},
  huname = {1},
  hyphenation = {magyar},
  keywords = {pavement management, bearing capacity, benkelman beam, lacroix deflectograph,
	falling weight deflectometer, forest roads},
  owner = {Primusz Péter},
  review = {Texts were not revised by editors},
  timestamp = {2010.01.24}
}

