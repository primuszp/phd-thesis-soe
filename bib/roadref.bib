@CONFERENCE{Molenaar2003,
  author = {A. A. A. Molenaar and L. J. M. Houben and A. A. Alemgena},
  title = {Estimation of maximum strains in road bases for pavement performance
	predictions},
  booktitle = {Maintenance and Rehabilitation of Pavements and Technological Control},
  year = {2003},
  pages = {199--206},
  address = {University of Minho, Guimaraes, Portugal},
  abstract = {In the current design procedures for flexible pavements the tensile
	strain at the bottom of the asphalt layer and the vertical compressive
	strain at the top of the sub-grade are usually taken as the critical
	design criteria. Procedures have been developed that allow these
	two design criteria to be estimated from deflection test results.
	Normally the vertical compressive strain at the top of the base is
	not taken as a design criterion and for thin asphalt pavements this
	can be considered as a disadvantage. This paper describes how the
	vertical compressive strain at the top of the base can be estimated
	from deflection measurements. Furthermore the paper describes how
	failure criteria for unbound base materials have been developed from
	the results of repeated load triaxial tests.},
  owner = {Primusz Péter},
  timestamp = {2012.01.11}
}

