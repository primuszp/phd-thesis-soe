@ARTICLE{Rosyidi2007,
  author = {Sri Atmaja P. Rosyidi},
  title = {Comparison Between 2-D And 3-D Stiffness Matrix Model Simulation
	of Sasw Inversion for Pavement
	
	Structure},
  journal = {Civil Engineering Dimension},
  year = {2007},
  volume = {9},
  pages = {42--48},
  number = {1},
  month = {March},
  abstract = {The Spectral Analysis of Surface Wave (SASW) method is a non-destructive
	in situ seismic echnique used toassess and evaluate the material
	stiffness (dynamic elastic modulus) and hickness of pavement layers
	at low strains. These values can be used analytically to calculate
	load apacities in order to predict the performance of pavement system.
	The SASW method is based on the ispersion phenomena of Rayleigh waves
	in layeredmedia. In order to get the actual shear wave velocities,
	2-D and 3-D models are used in the simulation of theinversion process
	for best fitting between theoretical and empirical dispersion curves.
	The objective of this studyis to simulate and compare the 2-D and
	3-D model of SASW analysis in the construction of the theoretical
	dispersion curve for pavement structure evaluation. The result showed
	that the dispersion curve from the 3-D model was similar with the
	dispersion curve of the actual pavement profile compared to the 2-D
	model. Thewave velocity profiles also showed that the 3-D model used
	in the SASW analysis is able to detect all the distinctlayers of
	flexible pavement units.},
  file = {:D\:\\My Library\\articles\\Comparison Between 2-D And 3-D Stiffness Matrix Model Simulation of Sasw Inversion for Pavement.pdf:PDF},
  huname = {2},
